root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{kt,kts}]
indent_style = space
indent_size = 2
continuation_indent_size = 2
max_line_length = 100

[*.{xml,yml,yaml,json,toml}]
indent_style = space
indent_size = 2
